#include <winver.h>

#define PRODUCTVERSION_STR "{{VERSION}}"
#define FILEVERSION_STR "{{VERSION}}.0"
#define PRODUCTVERSION_CSV {{VERSION_CSV}}
#define FILEVERSION_CSV {{VERSION_CSV}},0

VS_VERSION_INFO VERSIONINFO
FILEVERSION     FILEVERSION_CSV
PRODUCTVERSION  PRODUCTVERSION_CSV
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",        "OpenList Contributors"
            VALUE "FileDescription",   "OpenList Server"
            VALUE "FileVersion",       FILEVERSION_STR
            VALUE "InternalName",      "openlist"
            VALUE "LegalCopyright",    "Copyright © The OpenList Project Contributors"
            VALUE "OriginalFilename",  "openlist.exe"
            VALUE "ProductName",       "OpenList"
            VALUE "ProductVersion",    PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END